# =====================================================================
# MEMES PAGES — Environment configuration
# Copy to `.env` and fill in the values. NEVER commit the real .env file.
# =====================================================================

# ── Core ─────────────────────────────────────────────────────────────
MEMES_ENV=development                # development | production
MEMES_SECRET_KEY=change-me-to-a-long-random-string
MEMES_LOG_LEVEL=INFO

# ── Database (PostgreSQL) ────────────────────────────────────────────
MEMES_DATABASE_URL=postgresql://memes:memes@localhost:5432/memes_pages
# Local/test fallback (SQLite is used automatically only if this is unset
# AND MEMES_SQLITE_FALLBACK=true — production must use PostgreSQL):
MEMES_SQLITE_FALLBACK=true

# ── Redis (optional — rate-limit buckets & caching; falls back to memory) ──
MEMES_REDIS_URL=redis://localhost:6379/0

# ── Admin bootstrap (created by `python -m scripts.seed_admin`) ──────
MEMES_ADMIN_EMAIL=admin@memespages.local
MEMES_ADMIN_PASSWORD=change-me-strong-password

# ── Telegram ─────────────────────────────────────────────────────────
# Bot token from @BotFather
MEMES_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to control the bot
MEMES_ADMIN_TELEGRAM_IDS=
# Optional: public HTTPS base URL to run the bot via webhook instead of polling
MEMES_WEBHOOK_URL=
# Optional: webhook secret token
MEMES_WEBHOOK_SECRET=

# ── Media storage ────────────────────────────────────────────────────
MEMES_MEDIA_DIR=./media
# Public base URL where the backend serves /media (needed by publishers that
# fetch media from a URL, e.g. Instagram Graph API video_url)
MEMES_PUBLIC_MEDIA_BASE_URL=

# ── Credential encryption (stores destination-account tokens encrypted) ──
# Generate with: python -c "import os;print(os.urandom(32).hex())"
MEMES_CREDENTIAL_ENCRYPTION_KEY=

# ── Rate limiting ────────────────────────────────────────────────────
MEMES_API_RATE_LIMIT=120/minute

# ── Frontend ─────────────────────────────────────────────────────────
# Where the Next.js server proxies /api/v1 to (server-side only)
API_INTERNAL_URL=http://127.0.0.1:8000

# ── Agent-Reach (optional discovery provider; disabled unless set) ───
MEMES_AGENT_REACH_ENABLED=false
MEMES_AGENT_REACH_BIN=agent-reach
