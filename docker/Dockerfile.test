# /app is the WORKDIR in every Python container
FROM python:3.12-slim

WORKDIR /app
RUN pip install --no-cache-dir pytest pytest-asyncio ruff

COPY requirements.txt shared/ ./
RUN pip install --no-cache-dir -r requirements.txt && pip install --no-deps ./shared

COPY backend/ ./backend/
COPY worker/ ./worker/
COPY telegram-bot/ ./telegram-bot/
COPY scripts/ ./scripts/
COPY tests/ ./tests/

ENV PYTHONPATH=/app:/app/backend
CMD ["python", "-m", "pytest", "tests", "-v"]
