# Shared Python image for backend / worker / telegram-bot
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# ffmpeg for video processing, curl for healthchecks
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install -r /app/requirements.txt

COPY shared/ /app/shared/
RUN pip install --no-deps /app/shared

COPY backend/ /app/backend/
COPY worker/ /app/worker/
COPY telegram-bot/ /app/telegram-bot/
COPY scripts/ /app/scripts/
COPY docker/entrypoint.sh /app/docker/entrypoint.sh
RUN chmod +x /app/docker/entrypoint.sh

# ROLE env var (api | worker | telegram-bot) selects the process; default api.
ENTRYPOINT ["sh", "/app/docker/entrypoint.sh"]
